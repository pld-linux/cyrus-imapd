+static void test_b64encode_mimebody_length(void)
+{
+    /* Sanity: a small input encodes correctly and reports the right length. */
+    static const char PLAIN[] = "foobar";
+    static const char B64[] = "Zm9vYmFy";
+    char buf[64];
+    size_t outlen = 0;
+    size_t outlines = 0;
+
+    charset_b64encode_mimebody(PLAIN, sizeof(PLAIN)-1, buf, &outlen, &outlines, 0);
+    CU_ASSERT_EQUAL(outlen, sizeof(B64)-1);
+    CU_ASSERT_MEMEQUAL(buf, B64, sizeof(B64)-1);
+
+    /* Check that outlen is sane for lengths greater than 32-bit integers. */
+    outlen = 0;
+    /* 3221225470 input bytes encode to exactly 4294967296 (2^32) output
+     * bytes, which wraps to 0 in a signed 32-bit int. */
+    charset_b64encode_mimebody(NULL, (size_t) 3221225470UL, NULL, &outlen, NULL, 0);
+    CU_ASSERT_EQUAL(outlen, (size_t) 4294967296ULL);
+}
